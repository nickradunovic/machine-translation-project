# Optional: point the script at a local env file.
# TRANSLATE_ENV_FILE=.env

# Primary Azure OpenAI / Azure AI Foundry OpenAI-compatible endpoint.
# Used by:
# - Llama-3.3-70B-Instruct
# - Meta-Llama-3.1-405B-Instruct
# - Meta-Llama-3.1-8B-Instruct
# - gpt-4
TRANSLATE_ENDPOINT_PRIMARY=https://your-primary-resource.cognitiveservices.azure.com
TRANSLATE_API_KEY_PRIMARY=your-primary-api-key

# Microsoft Translator Text API.
TRANSLATE_URL=https://api.cognitive.microsofttranslator.com/translate
TRANSLATE_KEY=your-microsoft-translator-key
TRANSLATE_REGION=westeurope

# Optional deployment/model overrides.
# If unset, the script falls back to the literal values shown here.
TRANSLATE_MODEL_LLAMA_3_3_70B=Llama-3.3-70B-Instruct
TRANSLATE_MODEL_META_LLAMA_3_1_405B=Meta-Llama-3.1-405B-Instruct
TRANSLATE_MODEL_META_LLAMA_3_1_8B=Meta-Llama-3.1-8B-Instruct
TRANSLATE_MODEL_GPT_4=gpt-4
TRANSLATE_MODEL_GPT_5_2=gpt-5.2
